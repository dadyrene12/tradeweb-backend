PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/hitek
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_REMEMBER_EXPIRES_IN=30d
CLIENT_URL=https://www.rnsmartelectronic.rw,https://rnsmartelectronic.rw,https://rn-smartelectronic-campany-ltdrw.vercel.app,http://localhost:3000
COOKIE_DOMAIN=

ADMIN_NAME=Store Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_to_a_strong_password

# Option 1: Resend API (recommended for Render/Vercel deployments).
# Verify your domain in Resend and use an address on that domain in EMAIL_FROM.
RESEND_API_KEY=

# Option 2: SMTP (Gmail, Brevo, Mailgun, Zoho, etc.).
# Gmail example: host smtp.gmail.com, port 587, secure false,
# user = your Gmail address, pass = a 16-character Google App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Glectron <no-reply@yourdomain.com>"

# Instagram auto-post. Requires an Instagram Business/Creator account linked
# to a Facebook Page and a Meta long-lived access token with content publish permission.
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_VERSION=v21.0
# Public HTTPS base URL of this backend (used for /uploads product images).
PUBLIC_SERVER_URL=https://your-backend.onrender.com
